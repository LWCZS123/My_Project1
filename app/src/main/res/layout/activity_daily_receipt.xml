<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E4EEF9"
    tools:context=".ui.activity.DailyReceiptActivity">

    <!-- ══ 顶部导航栏 (透明背景) ══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#333333"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日小票"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══ KAPI复古蓝色热敏小票打印机 (加宽设计与蓝色彩调) ══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPrinter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_printer_body"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp"
        android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. 顶部出纸口 (Exit Slit Bar) -->
        <View
            android:id="@+id/vPrinterSlit"
            android:layout_width="240dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_printer_slit"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 2. 打印机品牌标语 (Brand Title & Subtitle) -->
        <TextView
            android:id="@+id/tvPrinterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="K A P I   A I   P R I N T"
            android:textColor="#2C3E50"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            app:layout_constraintTop_toBottomOf="@id/vPrinterSlit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvPrinterSubName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="—— KEEP YOUR MOMENTS ——"
            android:textColor="#5A738E"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            app:layout_constraintTop_toBottomOf="@id/tvPrinterName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 3. 中央黑屏显示区域 (LCD Screen Display) -->
        <LinearLayout
            android:id="@+id/llPrinterScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_printer_screen"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvPrinterSubName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 第一行：下单人 & 结算时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOrderUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下单人：毛毛球"
                    android:textColor="#38BDF8"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvOrderTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="结算时间：2026-09-05 23:55:53"
                    android:textColor="#38BDF8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 第二行：交易号 & 收银员 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTradeNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="交易号：1791993233467"
                    android:textColor="#38BDF8"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvCashier"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="收银员：胖咔"
                    android:textColor="#38BDF8"
                    android:textSize="11.5sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 4. 底部控制排布 (Toggle Badge + Status LEDs + PRINT Button) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/llPrinterScreen"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 左侧双圈胶囊按钮组 -->
            <LinearLayout
                android:id="@+id/llTogglePill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_printer_toggle_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <View
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_printer_red_dot" />

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_printer_white_dot">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_sparkle"
                        app:tint="#2563EB" />
                </FrameLayout>
            </LinearLayout>

            <!-- 中间状态指示灯 (PWR & AI) -->
            <LinearLayout
                android:id="@+id/llLedContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toEndOf="@id/llTogglePill"
                app:layout_constraintEnd_toStartOf="@id/flPrintButton"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- PWR 电源指示灯 (带闪烁动画) -->
                <FrameLayout
                    android:id="@+id/flPrinterLed"
                    android:layout_width="12dp"
                    android:layout_height="12dp">

                    <View
                        android:id="@+id/vLedGlow"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_printer_led_green_glow" />

                    <View
                        android:id="@+id/vLedCore"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_printer_led_green_core" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="PWR"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- AI 工作指示灯 -->
                <FrameLayout
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="14dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_printer_led_orange_glow" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_printer_led_orange_core" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="AI"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 右侧 PRINT 圆形主按键 -->
            <FrameLayout
                android:id="@+id/flPrintButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_printer_print_btn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="PRINT"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══ 滚动区域：包含完整小票卡片 (宽度拓展) ══ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:paddingHorizontal="28dp"
        android:paddingTop="60dp"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 包含主体与锯齿边缘的容器（保存图片截取目标，初始隐藏防止动画前闪现） -->
        <LinearLayout
            android:id="@+id/llReceiptPaperContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:elevation="6dp"
            android:alpha="0.0"
            android:visibility="invisible">

            <!-- 小票主体白纸部分 -->
            <LinearLayout
                android:id="@+id/llPaperBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <!-- 票据顶部标志 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KAPI DAILY RECEIPT"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—— 每日收支明细单 ——"
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 分隔虚线 1 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_receipt_dash_line"
                    android:layerType="software" />

                <!-- 列标头与日期选择 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="类目"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- 日期切换按钮 -->
                    <LinearLayout
                        android:id="@+id/btnSelectDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp">

                        <TextView
                            android:id="@+id/tvCurrentDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026-09-05"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_arrow_downward"
                            app:tint="#333333" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="价格"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 分隔虚线 2 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_receipt_dash_line"
                    android:layerType="software" />

                <!-- 账单列表 (合并相同分类) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReceiptBills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_receipt_bill" />

                <!-- 空状态提示 -->
                <TextView
                    android:id="@+id/tvEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="24dp"
                    android:text="本日暂无收支记录 ~"
                    android:textColor="#999999"
                    android:textSize="13.5sp"
                    android:visibility="gone" />

                <!-- 分隔虚线 3 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_receipt_dash_line"
                    android:layerType="software" />

                <!-- 底部统计区域 (匹配用户截图布局) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 第一行：账单笔数 / 商品数量 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="账单笔数"
                            android:textColor="#666666"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvRecordCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="0 笔"
                            android:textColor="#333333"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <!-- 第二行：收入合计 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="收入合计"
                            android:textColor="#666666"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvIncomeTotal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="¥0.00"
                            android:textColor="#333333"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <!-- 中间分隔虚线 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginVertical="12dp"
                        android:background="@drawable/bg_receipt_dash_line"
                        android:layerType="software" />

                    <!-- 第三行：实付合计 / 消费总计高亮大字 (匹配截图) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- 左侧标题与副标 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="消费总计"
                                android:textColor="#1E293B"
                                android:textSize="15.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="已计入当日明细"
                                android:textColor="#999999"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- 右侧大字金额 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end|bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:text="￥"
                                android:textColor="#F25622"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvExpenseTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00"
                                android:textColor="#F25622"
                                android:textSize="23sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- 分隔虚线 4 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="16dp"
                    android:background="@drawable/bg_receipt_dash_line"
                    android:layerType="software" />

                <!-- 底部温馨短语与印章 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvPoeticQuote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/flStamp"
                        android:layout_centerVertical="true"
                        android:lineSpacingExtra="4dp"
                        android:text="晚风轻拂过窗沿\n细碎的声音漫进房间\n那些拢起的暖意\n都在夜色里慢慢沉淀"
                        android:textColor="#555555"
                        android:textSize="12.5sp" />

                    <!-- 印章图案 -->
                    <FrameLayout
                        android:id="@+id/flStamp"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_receipt_stamp"
                        android:padding="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAILY"
                                android:textColor="#E57373"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_cat"
                                app:tint="#E57373" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RECEIPT"
                                android:textColor="#E57373"
                                android:textSize="8sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </RelativeLayout>

            </LinearLayout>

            <!-- 锯齿撕边 View -->
            <com.example.my_project1.ui.view.ReceiptSawToothView
                android:layout_width="match_parent"
                android:layout_height="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ 底部保存图片按钮 (初始隐藏，动画全部完成后显现) ══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnSaveImage"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        android:alpha="0.0"
        app:cardBackgroundColor="#2F6BFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_download"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="保存图片"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
