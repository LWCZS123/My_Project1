<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF1FB"
    tools:context=".ui.activity.DailyReceiptActivity">

    <!-- ══ 顶部导航栏 (透明背景) ══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#333333"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日小票"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══ 大号动漫迷你打印机 (位置上移，加宽加大完全覆盖小票) ══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPrinter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:layout_marginTop="-6dp"
        android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. 打印机顶盖 (Top Cap) -->
        <View
            android:id="@+id/vPrinterTopCap"
            android:layout_width="230dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_printer_top_cap"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 2. 打印机主机身 (Main Body) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clPrinterBody"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_printer_body"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 左侧装饰点 -->
            <LinearLayout
                android:id="@+id/llLeftDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/flPrinterSlit">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_printer_dot" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_printer_dot" />
            </LinearLayout>

            <!-- 中间标识 -->
            <TextView
                android:id="@+id/tvPrinterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M I N I   P R I N T"
                android:textColor="#C2DBFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/flPrinterSlit" />

            <!-- 右侧青蓝霓虹灯 CONTAINER -->
            <FrameLayout
                android:id="@+id/flPrinterLed"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/flPrinterSlit">

                <View
                    android:id="@+id/vLedGlow"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_printer_led_glow" />

                <View
                    android:id="@+id/vLedCore"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_printer_led_core" />
            </FrameLayout>

            <!-- 3. 出纸口 (Paper Slit) -->
            <FrameLayout
                android:id="@+id/flPrinterSlit"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_printer_slit_outer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_printer_slit_inner" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══ 滚动区域：包含完整小票卡片 ══ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingTop="60dp"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 包含主体与锯齿边缘的容器（保存图片截取目标，保持透明背景） -->
        <LinearLayout
            android:id="@+id/llReceiptPaperContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:elevation="6dp">

            <!-- 小票主体白纸部分 -->
            <LinearLayout
                android:id="@+id/llPaperBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <!-- 票据顶部元信息 -->
                <TextView
                    android:id="@+id/tvOrderUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下单人：小管家"
                    android:textColor="#666666"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvOrderTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="下单时间：2026-09-05 23:59:59"
                    android:textColor="#666666"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/tvTradeNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="交易号：1781993233457"
                        android:textColor="#666666"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvCashier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="收银员：胖咔"
                        android:textColor="#666666"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- 分隔虚线 1 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_receipt_dash_line"
                    android:layerType="software" />

                <!-- 列标头与日期选择 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="类目"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- 日期切换按钮 -->
                    <LinearLayout
                        android:id="@+id/btnSelectDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp">

                        <TextView
                            android:id="@+id/tvCurrentDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026-09-05"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_arrow_downward"
                            app:tint="#333333" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="价格"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 分隔虚线 2 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_receipt_dash_line"
                    android:layerType="software" />

                <!-- 账单列表 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReceiptBills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_receipt_bill" />

                <!-- 空状态提示 -->
                <TextView
                    android:id="@+id/tvEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="24dp"
                    android:text="本日暂无收支记录 ~"
                    android:textColor="#999999"
                    android:textSize="13.5sp"
                    android:visibility="gone" />

                <!-- 分隔虚线 3 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_receipt_dash_line"
                    android:layerType="software" />

                <!-- 底部统计区域 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRecordCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="记录笔数： 0笔"
                        android:textColor="#333333"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/tvIncomeTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="收入合计： ¥0.00"
                        android:textColor="#333333"
                        android:textSize="13.5sp" />

                    <!-- 消费总计高亮块 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="消费总计："
                            android:textColor="#333333"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvExpenseTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#FFEBD8"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="¥0.00"
                            android:textColor="#D84315"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 分隔虚线 4 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="16dp"
                    android:background="@drawable/bg_receipt_dash_line"
                    android:layerType="software" />

                <!-- 底部温馨短语与印章 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvPoeticQuote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/flStamp"
                        android:layout_centerVertical="true"
                        android:lineSpacingExtra="4dp"
                        android:text="晚风轻拂过窗沿\n细碎的声音漫进房间\n那些拢起的暖意\n都在夜色里慢慢沉淀"
                        android:textColor="#555555"
                        android:textSize="12.5sp" />

                    <!-- 印章图案 -->
                    <FrameLayout
                        android:id="@+id/flStamp"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_receipt_stamp"
                        android:padding="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAILY"
                                android:textColor="#E57373"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_cat"
                                app:tint="#E57373" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RECEIPT"
                                android:textColor="#E57373"
                                android:textSize="8sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </RelativeLayout>

            </LinearLayout>

            <!-- 锯齿撕边 View -->
            <com.example.my_project1.ui.view.ReceiptSawToothView
                android:layout_width="match_parent"
                android:layout_height="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ 底部保存图片按钮 (初始隐藏，动画全部完成后显现) ══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnSaveImage"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        android:alpha="0.0"
        app:cardBackgroundColor="#2F6BFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_download"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="保存图片"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
