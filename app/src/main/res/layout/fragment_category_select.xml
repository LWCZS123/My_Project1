<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingBottom="24dp"
    android:paddingTop="12dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D1D1D6"
        android:layout_marginBottom="16dp"
        app:cornerRadius="2dp"/>

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="选择预算分类"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="请选择需要设置或修改预算的分类"
        android:textSize="13sp"
        android:textColor="#8E8E93"
        android:layout_marginBottom="24dp"/>

    <!-- 一级 / 二级 切换胶囊 -->
    <LinearLayout
        android:id="@+id/ll_level_tabs"
        android:layout_width="260dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_capsule_small"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_level_main"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="一级分类"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_selected_blue"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/tab_level_sub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="二级分类"
            android:textSize="14sp"
            android:textColor="#8E8E93"/>
    </LinearLayout>

    <!-- 分类列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categories"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:layout_marginBottom="24dp"
        tools:listitem="@layout/item_category_budget_selector"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:spanCount="4"/>

    <!-- Confirm Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="确 认"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:cornerRadius="16dp"
        app:backgroundTint="#007AFF"
        app:elevation="0dp"
        app:rippleColor="#33FFFFFF"/>

</LinearLayout>
