<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_wish_card"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="82dp"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="8dp"
    android:paddingBottom="13dp">

    <FrameLayout
        android:id="@+id/icon_container"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_wish_icon"
        android:padding="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_wish_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="存钱记录"
            android:src="@drawable/ic_money2" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_record_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textColor="#6F6972"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/btn_delete_record"
        app:layout_constraintStart_toEndOf="@id/icon_container"
        app:layout_constraintTop_toTopOf="@id/icon_container" />

    <TextView
        android:id="@+id/tv_record_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#262229"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tv_record_date"
        app:layout_constraintTop_toBottomOf="@id/tv_record_date" />

    <TextView
        android:id="@+id/tv_record_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#918B95"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_record_amount"
        app:layout_constraintEnd_toStartOf="@id/btn_delete_record"
        app:layout_constraintStart_toEndOf="@id/tv_record_amount" />

    <ImageView
        android:id="@+id/btn_delete_record"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="删除记录"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_trash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#918B95" />
</androidx.constraintlayout.widget.ConstraintLayout>
