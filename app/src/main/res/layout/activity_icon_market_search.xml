<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/market_page_bg">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circle_market_white"
        android:contentDescription="返回"
        android:padding="8dp"
        android:src="@drawable/ic_back3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/market_text_main" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="搜索"
        android:textColor="@color/market_text_main"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_search_box"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_search_box_market"
        android:paddingHorizontal="14dp"
        android:transitionName="icon_market_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back">

        <ImageView
            android:id="@+id/iv_search"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="搜索"
            android:src="@drawable/ic_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/market_text_secondary" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="搜索单个图标..."
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/market_text_main"
            android:textColorHint="@color/market_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/btn_clear"
            app:layout_constraintStart_toEndOf="@id/iv_search" />

        <ImageButton
            android:id="@+id/btn_clear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="清空搜索"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/market_text_secondary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layout_result_types"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_search_type_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintEnd_toStartOf="@id/layout_view_modes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_search_box">

        <TextView
            android:id="@+id/tab_collections"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_unselected_market"
            android:gravity="center"
            android:text="图标合集"
            android:textColor="@color/market_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tab_icons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_selected_market"
            android:gravity="center"
            android:text="✦ 单个图标"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_view_modes"
        android:layout_width="88dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_search_type_container"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintBottom_toBottomOf="@id/layout_result_types"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_result_types">

        <ImageView
            android:id="@+id/btn_grid"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_search_mode_unselected"
            android:contentDescription="网格视图"
            android:padding="9dp"
            android:src="@drawable/ic_menu"
           />

        <ImageView
            android:id="@+id/btn_list"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_search_mode_unselected"
            android:layout_marginStart="3dp"
            android:padding="9dp"
            android:src="@drawable/ic_list"
            app:tint="@color/batch_download_primary_blue"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_styles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_result_types">

        <TextView
            android:id="@+id/style_all"
            style="@style/IconSearchStyleChip"
            android:background="@drawable/bg_pill_selected_market"
            android:text="全部"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/style_linear"
            style="@style/IconSearchStyleChip"
            android:text="线性" />

        <TextView
            android:id="@+id/style_colored"
            style="@style/IconSearchStyleChip"
            android:text="彩色" />

        <TextView
            android:id="@+id/style_filled"
            style="@style/IconSearchStyleChip"
            android:layout_marginEnd="0dp"
            android:text="填充" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_result_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:text="推荐图标"
        android:textColor="@color/market_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_styles" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_search_results"
        android:clipToOutline="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_result_summary"
        tools:listitem="@layout/item_icon_row" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/empty_lottie"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tv_empty"
        app:layout_constraintEnd_toEndOf="@id/rv_results"
        app:layout_constraintStart_toStartOf="@id/rv_results"
        app:layout_constraintTop_toTopOf="@id/rv_results"
        app:lottie_autoPlay="false"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/empty_search" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/progress_loading"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_results"
        app:layout_constraintEnd_toEndOf="@id/rv_results"
        app:layout_constraintStart_toStartOf="@id/rv_results"
        app:layout_constraintTop_toTopOf="@id/rv_results"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loading" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="没有找到匹配内容\n换个关键词试试"
        android:textColor="@color/market_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_results"
        app:layout_constraintEnd_toEndOf="@id/rv_results"
        app:layout_constraintStart_toStartOf="@id/rv_results"
        app:layout_constraintTop_toBottomOf="@id/empty_lottie" />

</androidx.constraintlayout.widget.ConstraintLayout>
