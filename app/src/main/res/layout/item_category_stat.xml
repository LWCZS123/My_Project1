<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 左侧圆形图标 - 调小 -->
    <FrameLayout
        android:id="@+id/fl_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp">

        <!-- 淡色圆背景 -->
        <View
            android:id="@+id/v_icon_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_category_icon_circle"/>

        <!-- 分类图标 -->
        <ImageView
            android:id="@+id/iv_category_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:padding="1dp"
            android:scaleType="fitCenter"/>
    </FrameLayout>

    <!-- 中间内容：分类名 + 进度条 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_category_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#999999"
                android:textSize="12sp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="10000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_capsule"/>
    </LinearLayout>

    <!-- 右侧折叠感应区：包含金额、箭头、笔数 -->
    <LinearLayout
        android:id="@+id/ll_expand_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingStart="12dp"
        android:paddingEnd="0dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_category_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_arrow_down"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            app:tint="#DDDDDD"/>

        <TextView
            android:id="@+id/tv_bill_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#BBBBBB"
            android:textSize="11sp"/>
    </LinearLayout>

</LinearLayout>