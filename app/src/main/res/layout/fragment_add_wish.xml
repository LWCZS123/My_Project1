<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/form_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_add_wish_sheet"
    android:clipToOutline="true"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <!-- ✅ 关键修复1：外层LinearLayout也需要关闭裁剪，否则角标仍会被裁切 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drag_handle" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="关闭"
                android:focusable="true"
                android:padding="12dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow_right"
                app:tint="#4D6075" />

            <TextView
                android:id="@+id/tv_form_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="添加愿望"
                android:textColor="#172B4D"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- ✅ 关键修复2：FrameLayout自身关闭裁剪 + clipToPadding -->
        <FrameLayout
            android:id="@+id/icon_picker"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_wish_icon_picker"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:contentDescription="选择愿望图标"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="19dp">

            <ImageView
                android:id="@+id/iv_wish_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="愿望图标"
                android:scaleType="centerInside"
                android:src="@drawable/ic_piggy_bank" />

            <ImageView
                android:id="@+id/iv_change_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_circle_blue"
                android:contentDescription="更换图标"
                android:padding="5dp"
                android:src="@drawable/ic_edit1"
                android:translationX="10dp"
                android:translationY="10dp"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_name"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="40dp"
            android:paddingBottom="4dp"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxBackgroundMode="none"
            app:errorEnabled="true"
            app:errorIconDrawable="@null"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:backgroundTint="#B9CCE3"
                android:gravity="center"
                android:hint="请输入愿望名称"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLength="30"
                android:singleLine="true"
                android:textColor="#172B4D"
                android:textColorHint="#91A2B5"
                android:textSize="21sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="目标金额"
                        android:src="@drawable/ic_money1"
                        app:tint="#4A78B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="目标金额"
                        android:textColor="#6F8297"
                        android:textSize="15sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_target"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        app:boxBackgroundMode="none"
                        app:errorEnabled="true"
                        app:errorIconDrawable="@null"
                        app:hintEnabled="false"
                        app:prefixText="¥"
                        app:prefixTextColor="#172B4D">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_target_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="100dp"
                            android:background="@null"
                            android:gravity="end|center_vertical"
                            android:hint="0.00"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:paddingEnd="2dp"
                            android:singleLine="true"
                            android:textColor="#172B4D"
                            android:textColorHint="#A7B4C2"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EDF2F7" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="开始时间"
                        android:src="@drawable/ic_calendar3"
                        app:tint="#4A78B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="开始时间"
                        android:textColor="#6F8297"
                        android:textSize="15sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_start_date"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:gravity="end|center_vertical"
                            android:inputType="none"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="#172B4D"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="选择开始时间"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#A7B4C2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EDF2F7" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="备注"
                        android:src="@drawable/ic_remark"
                        app:tint="#4A78B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="备注"
                        android:textColor="#6F8297"
                        android:textSize="15sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_remark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@null"
                            android:gravity="end|center_vertical"
                            android:hint="选填"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="200"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:textColor="#172B4D"
                            android:textColorHint="#A7B4C2"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:text="确认添加"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#3478D4"
            app:cornerRadius="10dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>