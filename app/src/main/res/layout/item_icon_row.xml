<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:background="@color/white">

    <!-- 多选按钮 -->
    <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:button="@drawable/sl_checkbox_modern"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- 图标容器 -->
    <FrameLayout
        android:id="@+id/layout_icon_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_item_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/cb_select"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_icon_preview"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Icon Preview"
             />
    </FrameLayout>

    <!-- 名称部分 -->
    <TextView
        android:id="@+id/tv_name_cn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/market_text_main"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="相机"
        app:layout_constraintStart_toEndOf="@id/layout_icon_container"
        app:layout_constraintTop_toTopOf="@id/layout_icon_container"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@id/tv_name_en" />

    <TextView
        android:id="@+id/tv_name_en"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/market_text_secondary"
        android:textSize="12sp"
        android:text="Camera"
        app:layout_constraintStart_toEndOf="@id/layout_icon_container"
        app:layout_constraintTop_toBottomOf="@id/tv_name_cn"
        app:layout_constraintBottom_toBottomOf="@id/layout_icon_container" />

    <!-- 线性标签 -->
    <TextView
        android:id="@+id/tv_row_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_pill_selected_market"
        android:backgroundTint="#EBEDFF"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="线性"
        android:textColor="@color/market_primary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_row_download" />

    <!-- 下载按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_row_download"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:backgroundTint="#EBEDFF"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="10dp"
        android:text="下载"
        android:textAllCaps="false"
        android:textColor="@color/market_primary"
        android:textSize="11sp"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconSize="12dp"
        app:iconTint="@color/market_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 分割线 -->
    <View
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="#F0F0F0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_name_cn"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
