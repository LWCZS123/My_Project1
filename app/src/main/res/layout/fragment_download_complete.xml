<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_white"
    android:paddingBottom="24dp">

    <!-- Handle Bar -->
    <View
        android:id="@+id/handle_bar"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="#E0E4ED"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Success Icon Container -->
    <FrameLayout
        android:id="@+id/layout_success_icon"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_success_circle_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/handle_bar">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check_white" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="下载完成！"
        android:textColor="@color/batch_download_text_main"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_success_icon" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Vivid Color Pack 已保存至本地"
        android:textColor="@color/batch_download_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <!-- Stats Section -->
    <LinearLayout
        android:id="@+id/layout_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

        <!-- File Size -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card_light"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_package" />

            <TextView
                android:id="@+id/tv_file_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="14.2 MB"
                android:textColor="@color/batch_download_text_main"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="文件大小"
                android:textColor="@color/batch_download_text_helper"
                android:textSize="9sp" />
        </LinearLayout>

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <!-- Icon Count -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card_light"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_star"
                app:tint="#303544" />

            <TextView
                android:id="@+id/tv_icon_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="256 枚"
                android:textColor="@color/batch_download_text_main"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="图标数量"
                android:textColor="@color/batch_download_text_helper"
                android:textSize="9sp" />
        </LinearLayout>

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <!-- Time Taken -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card_light"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_rise"
                app:tint="#FF8A00" />

            <TextView
                android:id="@+id/tv_time_taken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="8.3 秒"
                android:textColor="@color/batch_download_text_main"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="下载耗时"
                android:textColor="@color/batch_download_text_helper"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Path Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_path"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_path_card"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/layout_stats">

        <FrameLayout
            android:id="@+id/iv_folder_container"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="#EDF2FF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                app:tint="@color/batch_download_primary_blue" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_path_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="已保存至"
            android:textColor="@color/batch_download_text_helper"
            android:textSize="9sp"
            app:layout_constraintStart_toEndOf="@id/iv_folder_container"
            app:layout_constraintTop_toTopOf="@id/iv_folder_container" />

        <TextView
            android:id="@+id/tv_file_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="下载/图标合集/Vivid_Color_Pack.zip"
            android:textColor="@color/batch_download_text_main"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_path_label"
            app:layout_constraintTop_toBottomOf="@id/tv_path_label" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_file"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_gradient_button_orange"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="查看下载详情"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="20dp"
        app:iconTint="@color/white"
        app:layout_constraintTop_toBottomOf="@id/layout_path" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_continue"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        app:backgroundTint="#F7F9FD"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="继续下载更多"
        android:textAllCaps="false"
        android:textColor="#858DA2"
        android:textSize="13sp"
        app:cornerRadius="14dp"
        app:strokeColor="#E1E5EF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/btn_open_file" />

</androidx.constraintlayout.widget.ConstraintLayout>