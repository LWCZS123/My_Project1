<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/batch_download_page_background"
    android:fitsSystemWindows="true">

    <!-- 顶部导航栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/batch_download_margin_page"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="17dp"
            app:cardElevation="0dp"
            app:strokeColor="#F0F2F8"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back3"
                app:tint="@color/batch_download_primary_blue" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="批量下载"
            android:textColor="@color/batch_download_text_main"
            android:textSize="@dimen/batch_download_text_size_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btn_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="清除历史"
            android:textColor="@color/batch_download_primary_blue"
            android:textSize="@dimen/batch_download_text_size_body"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_close"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="@dimen/batch_download_margin_page"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="17dp"
            app:cardElevation="0dp"
            app:strokeColor="#F0F2F8"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close1"
                app:tint="#8790A8" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar"
        app:layout_constraintVertical_bias="0.4">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/ic_download_complete" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="暂无正在下载的任务，去挑选喜欢的图标吧"
            android:textColor="@color/batch_download_text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_actions"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/batch_download_margin_page">

            <!-- 下载位置管理卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_location_management"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/batch_download_card_radius"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/iv_location_icon_container"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_stat_blue"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="14dp"
                            android:src="@drawable/ic_folder"
                            app:tint="@color/batch_download_primary_blue" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_location_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="设置下载位置管理"
                        android:textColor="@color/batch_download_text_main"
                        android:textSize="@dimen/batch_download_text_size_card_title"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/tv_location_desc"
                        app:layout_constraintEnd_toStartOf="@+id/iv_arrow_right"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@id/iv_location_icon_container"
                        app:layout_constraintTop_toTopOf="@id/iv_location_icon_container"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_location_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="选择内部存储、SD卡或自定义路径"
                        android:textColor="@color/batch_download_text_secondary"
                        android:textSize="@dimen/batch_download_text_size_small"
                        app:layout_constraintBottom_toBottomOf="@id/iv_location_icon_container"
                        app:layout_constraintEnd_toStartOf="@+id/iv_arrow_right"
                        app:layout_constraintStart_toStartOf="@id/tv_location_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_location_title" />

                    <ImageView
                        android:id="@+id/iv_arrow_right"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_arrow_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#D1D5E0" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 下载状态卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="185dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/batch_download_card_radius"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp">

                    <!-- 环形进度 -->
                    <FrameLayout
                        android:id="@+id/layout_circular"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progress_circular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:progress="46"
                            app:indicatorColor="@color/batch_download_primary_blue"
                            app:indicatorSize="84dp"
                            app:trackColor="@color/batch_download_progress_circular_track"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_progress_percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="46%"
                                android:textColor="@color/batch_download_text_main"
                                android:textSize="@dimen/batch_download_text_size_percent"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="完成"
                                android:textColor="@color/batch_download_text_helper"
                                android:textSize="@dimen/batch_download_text_size_mini" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- 下载详情 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/layout_circular"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_dot_blue" />

                            <TextView
                                android:id="@+id/tv_progress_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="正在下载..."
                                android:textColor="@color/batch_download_primary_blue"
                                android:textSize="@dimen/batch_download_text_size_list_item" />
                        </LinearLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="已下载图标"
                                android:textColor="@color/batch_download_text_helper"
                                android:textSize="@dimen/batch_download_text_size_small"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_downloaded_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="117 / 256 枚"
                                android:textColor="@color/batch_download_text_label"
                                android:textSize="@dimen/batch_download_text_size_small"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="已下载大小"
                                android:textColor="@color/batch_download_text_helper"
                                android:textSize="@dimen/batch_download_text_size_small"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_downloaded_size"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6.5 / 14.2 MB"
                                android:textColor="@color/batch_download_text_label"
                                android:textSize="@dimen/batch_download_text_size_small"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="下载速度"
                                android:textColor="@color/batch_download_text_helper"
                                android:textSize="@dimen/batch_download_text_size_small"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_download_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.8 MB/s"
                                android:textColor="@color/batch_download_text_label"
                                android:textSize="@dimen/batch_download_text_size_small"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>

                    <!-- 横向进度条区域 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="下载进度"
                            android:textColor="@color/batch_download_text_helper"
                            android:textSize="@dimen/batch_download_text_size_small"
                            app:layout_constraintBottom_toTopOf="@id/progress_download"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tv_progress_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="117 / 256"
                            android:textColor="@color/batch_download_primary_blue"
                            android:textSize="@dimen/batch_download_text_size_small"
                            app:layout_constraintBottom_toTopOf="@id/progress_download"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_download"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:progress="46"
                            app:indicatorColor="@color/batch_download_primary_blue"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:trackColor="@color/batch_download_progress_bg"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 统计数据区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/batch_download_stat_bg_blue"
                    app:cardCornerRadius="@dimen/batch_download_stat_card_radius"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_collection_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 套"
                            android:textColor="@color/batch_download_primary_blue"
                            android:textSize="@dimen/batch_download_text_size_card_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="合集"
                            android:textColor="#858DA5"
                            android:textSize="@dimen/batch_download_text_size_mini" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/batch_download_stat_bg_red"
                    app:cardCornerRadius="@dimen/batch_download_stat_card_radius"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_icon_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="256"
                            android:textColor="@color/batch_download_error_red"
                            android:textSize="@dimen/batch_download_text_size_card_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="总图标"
                            android:textColor="#858DA5"
                            android:textSize="@dimen/batch_download_text_size_mini" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/batch_download_stat_bg_green"
                    app:cardCornerRadius="@dimen/batch_download_stat_card_radius"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_completed_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="117"
                            android:textColor="@color/batch_download_success_green"
                            android:textSize="@dimen/batch_download_text_size_card_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已完成"
                            android:textColor="#858DA5"
                            android:textSize="@dimen/batch_download_text_size_mini" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 图标列表卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/batch_download_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:id="@+id/btn_toggle_collections"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="图标合集"
                            android:textColor="@color/batch_download_primary_blue"
                            android:textSize="@dimen/batch_download_text_size_body"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/btn_toggle_singles"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="16dp"
                            android:gravity="center"
                            android:text="单个图标"
                            android:textColor="#8790A8"
                            android:textSize="@dimen/batch_download_text_size_body"
                            app:layout_constraintStart_toEndOf="@id/btn_toggle_collections" />

                        <TextView
                            android:id="@+id/btn_clear_history_list"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="清除历史"
                            android:textColor="@color/batch_download_error_red"
                            android:textSize="@dimen/batch_download_text_size_small"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/tv_list_total"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="12dp"
                            android:gravity="center"
                            android:text="共 0 枚"
                            android:textColor="#8790A8"
                            android:textSize="@dimen/batch_download_text_size_small"
                            app:layout_constraintEnd_toStartOf="@id/btn_clear_history_list" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/batch_download_divider_gray" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_icon_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_icon_download" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部悬浮按钮栏 -->
    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/batch_download_page_background"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/batch_download_margin_page"
        android:paddingVertical="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_download"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:backgroundTint="@color/batch_download_btn_cancel_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="取消下载"
            android:textAllCaps="false"
            android:textColor="#858DA2"
            android:textSize="13sp"
            app:cornerRadius="@dimen/batch_download_btn_radius"
            app:strokeColor="@color/batch_download_stroke_gray"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pause_download"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:backgroundTint="@color/batch_download_primary_blue"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="暂停下载"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="@dimen/batch_download_btn_radius" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>