<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/form_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_add_wish_sheet"
    android:clipToOutline="true"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 拖拽手柄 -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- 标题栏 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="关闭"
                android:focusable="true"
                android:padding="12dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow_right"
                app:tint="#4D6075" />

            <TextView
                android:id="@+id/tv_form_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="添加记录"
                android:textColor="#172B4D"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- 愿望图标与名称展示区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_wish_icon_picker"
                android:padding="19dp">

                <ImageView
                    android:id="@+id/iv_wish_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="愿望图标"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_piggy_bank" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_wish_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#172B4D"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 表单卡片区域 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <!-- 存入金额行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="存入金额"
                        android:src="@drawable/ic_money1"
                        app:tint="#4A78B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="存入金额"
                        android:textColor="#6F8297"
                        android:textSize="15sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥"
                            android:textColor="#172B4D"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <EditText
                            android:id="@+id/et_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="80dp"
                            android:background="@null"
                            android:gravity="end|center_vertical"
                            android:hint="0.00"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:padding="0dp"
                            android:singleLine="true"
                            android:textColor="#172B4D"
                            android:textColorHint="#A7B4C2"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EDF2F7" />

                <!-- 记录日期行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="记录日期"
                        android:src="@drawable/ic_calendar3"
                        app:tint="#4A78B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="记录日期"
                        android:textColor="#6F8297"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/et_record_date"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="end|center_vertical"
                        android:paddingEnd="8dp"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="选择日期"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#A7B4C2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EDF2F7" />

                <!-- 备注行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="备注"
                        android:src="@drawable/ic_remark"
                        app:tint="#4A78B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="备注"
                        android:textColor="#6F8297"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/et_note"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:hint="选填"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="200"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="#172B4D"
                        android:textColorHint="#A7B4C2"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 确认按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:text="确认存入"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#3478D4"
            app:cornerRadius="10dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
