<?xml version="1.0" encoding="utf-8"?>
<!-- 添加存钱计划底栏布局 - 适配四种存钱模式 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/form_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_add_saving_sheet"
    android:clipToOutline="true"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- 拖拽手柄 -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- 标题栏 -->
        <RelativeLayout
            android:id="@+id/rl_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="关闭"
                app:tint="#4D6075" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="存钱计划"
                android:textColor="#172B4D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_help"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@id/tv_title"
                android:src="@drawable/ic_question"
                android:contentDescription="帮助"
                app:tint="#315CF5" />

            <ImageView
                android:id="@+id/btn_save"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_blue"
                android:padding="6dp"
                android:src="@drawable/ic_check"
                android:contentDescription="保存"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <!-- 图标与名称 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/icon_picker"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_wish_icon_picker"
                android:padding="10dp">
                <ImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_food"
                    android:scaleType="centerInside"
                    android:contentDescription="计划图标" />
            </FrameLayout>

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_white_capsule"
                android:hint="计划名称"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172B4D"
                android:textColorHint="#CCCCCC"
                android:textSize="16sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 基础配置卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 开始时间 -->
                <LinearLayout
                    android:id="@+id/ll_start_date"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="开始时间"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tv_start_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#CCCCCC"
                        android:contentDescription="选择日期" />
                </LinearLayout>

                <View android:id="@+id/v_line_end_date" android:layout_width="match_parent" android:layout_height="1dp" android:background="#F8F8F8" android:layout_marginStart="16dp" android:visibility="gone" />

                <!-- 结束时间 (灵活存钱用) -->
                <LinearLayout
                    android:id="@+id/ll_end_date"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="结束时间"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tv_end_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#CCCCCC"
                        android:contentDescription="选择日期" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F8F8F8" android:layout_marginStart="16dp" />

                <!-- 起始金额 -->
                <LinearLayout
                    android:id="@+id/ll_initial_amount"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="起始金额"
                            android:textColor="#172B4D"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="创建计划前已经存入的金额"
                            android:textColor="#BBBBBB"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/et_initial_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="请输入金额"
                        android:inputType="numberDecimal"
                        android:minWidth="100dp"
                        android:textColor="#172B4D"
                        android:textColorHint="#CCCCCC"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        android:visibility="invisible"
                        android:contentDescription="占位" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 模式特定配置卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 计划周期 (定额用) -->
                <LinearLayout
                    android:id="@+id/ll_cycle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="计划周期"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tv_cycle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="每周"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#CCCCCC"
                        android:contentDescription="选择周期" />
                </LinearLayout>

                <View android:id="@+id/v_line_cycle" android:layout_width="match_parent" android:layout_height="1dp" android:background="#F8F8F8" android:layout_marginStart="16dp" android:visibility="gone" />

                <!-- 存钱额度 (定额用/52周用) -->
                <LinearLayout
                    android:id="@+id/ll_amount_row"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_amount_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="每周存钱"
                            android:textColor="#172B4D"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/tv_amount_sub_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="存钱描述"
                            android:textColor="#BBBBBB"
                            android:textSize="11sp"
                            android:visibility="gone"/>
                    </LinearLayout>
                    <EditText
                        android:id="@+id/et_main_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="请输入金额"
                        android:gravity="end"
                        android:inputType="numberDecimal"
                        android:minWidth="100dp"
                        android:textColor="#172B4D"
                        android:textColorHint="#CCCCCC"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        android:visibility="invisible"
                        android:contentDescription="占位" />
                </LinearLayout>

                <View android:id="@+id/v_line_amount" android:layout_width="match_parent" android:layout_height="1dp" android:background="#F8F8F8" android:layout_marginStart="16dp" />

                <!-- 持续时长 (定额用) -->
                <LinearLayout
                    android:id="@+id/ll_duration"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="持续时长"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 周"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#CCCCCC"
                        android:contentDescription="选择时长" />
                </LinearLayout>

                <!-- 递增金额 (52周/365天用) -->
                <LinearLayout
                    android:id="@+id/ll_increment"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="递增金额"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <EditText
                        android:id="@+id/et_increment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="请输入金额"
                        android:gravity="end"
                        android:inputType="numberDecimal"
                        android:minWidth="100dp"
                        android:textColor="#172B4D"
                        android:textColorHint="#CCCCCC"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        android:visibility="invisible"
                        android:contentDescription="占位" />
                </LinearLayout>

                <!-- 目标金额 (灵活存钱用) -->
                <LinearLayout
                    android:id="@+id/ll_target"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="目标金额"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <EditText
                        android:id="@+id/et_target"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="请输入金额"
                        android:gravity="end"
                        android:inputType="numberDecimal"
                        android:minWidth="100dp"
                        android:textColor="#172B4D"
                        android:textColorHint="#CCCCCC"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        android:visibility="invisible"
                        android:contentDescription="占位" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 额外配置卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 货币单位 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="货币单位"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="人民币"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#CCCCCC"
                        android:contentDescription="选择货币" />
                </LinearLayout>

                <View android:id="@+id/v_line_transfer" android:layout_width="match_parent" android:layout_height="1dp" android:background="#F8F8F8" android:layout_marginStart="16dp" />

                <!-- 打卡后记录转账 -->
                <LinearLayout
                    android:id="@+id/ll_transfer"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="打卡后记录转账"
                        android:textColor="#172B4D"
                        android:textSize="15sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_transfer"
                        style="@style/AppSwitchStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
