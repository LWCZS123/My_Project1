<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_white"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <!-- 拖动手柄 -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#E2E8F0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="24dp"
        android:text="账单筛选"
        android:textColor="#1E293B"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F6F6F6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 账单日期 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账单日期"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/btnYear" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_filter_chip" android:gravity="center" android:text="近一年" android:textColor="#64748B" android:textSize="14sp" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/btnWeek" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/bg_filter_chip" android:gravity="center" android:text="本周" android:textColor="#64748B" android:textSize="14sp" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/btnMonth" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/bg_filter_chip" android:gravity="center" android:text="本月" android:textColor="#64748B" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_filter_range"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">
                    <TextView android:id="@+id/tvStartDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始时间" android:textColor="#3B82F6" android:textSize="14sp" android:drawableEnd="@drawable/ic_arrow_down" android:drawablePadding="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:text="—" android:textColor="#94A3B8" android:textSize="14sp" />
                    <TextView android:id="@+id/tvEndDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="结束时间" android:textColor="#3B82F6" android:textSize="14sp" android:drawableEnd="@drawable/ic_arrow_down" android:drawablePadding="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 账单类型 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账单类型"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/btnTypeAll" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_filter_chip_selected" android:gravity="center" android:text="不限制" android:textColor="#3B82F6" android:textSize="14sp" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/btnTypeExpense" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_filter_chip" android:gravity="center" android:text="仅支出" android:textColor="#64748B" android:textSize="14sp" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/btnTypeIncome" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_filter_chip" android:gravity="center" android:text="仅收入" android:textColor="#64748B" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 更多筛选 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout android:id="@+id/btnSelectBook" android:layout_width="match_parent" android:layout_height="56dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="账本" android:textColor="#1E293B" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvSelectedBook" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="请选择账本 (单选) >" android:textColor="#94A3B8" android:textSize="14sp"/>
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#F1F5F9"/>

                <RelativeLayout android:id="@+id/btnSelectCategory" android:layout_width="match_parent" android:layout_height="56dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="分类" android:textColor="#1E293B" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvSelectedCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="请选择分类 (单选) >" android:textColor="#94A3B8" android:textSize="14sp"/>
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#F1F5F9"/>

                <RelativeLayout android:id="@+id/btnSelectAccount" android:layout_width="match_parent" android:layout_height="56dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="账户" android:textColor="#1E293B" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvSelectedAccount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="请选择账户 >" android:textColor="#94A3B8" android:textSize="14sp"/>
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout android:layout_width="match_parent" android:layout_height="56dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="是否计入预算" android:textColor="#1E293B" android:textSize="15sp"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBudget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        style="@style/AppSwitchStyle"/>
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#F1F5F9"/>

                <RelativeLayout android:layout_width="match_parent" android:layout_height="56dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="计入收支" android:textColor="#1E293B" android:textSize="15sp"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchExclude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        style="@style/AppSwitchStyle"/>
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:background="#FFFFFF">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="重置"
            android:textColor="#64748B"
            android:textSize="16sp"
            app:backgroundTint="#F1F5F9"
            app:cornerRadius="26dp"
            app:elevation="0dp"
            android:layout_marginEnd="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="确认"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#3B82F6"
            app:cornerRadius="26dp"
            app:elevation="0dp" />
    </LinearLayout>

</LinearLayout>
