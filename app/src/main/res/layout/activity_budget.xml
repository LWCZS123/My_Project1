<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/budget_page_bg">

    <!-- 顶部栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back3"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/budget_text_main"/>

        <!-- 标题 + 时间选择 (Container handles click) -->
        <LinearLayout
            android:id="@+id/ll_title_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_title_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="预算"
                android:textColor="@color/budget_text_main"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/iv_prev_period"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_back3"
                    android:padding="2dp"
                    app:tint="@color/budget_primary"/>

                <TextView
                    android:id="@+id/tv_date_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026年7月26日"
                    android:textSize="14sp"
                    android:textColor="@color/budget_text_main"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>

                <ImageView
                    android:id="@+id/iv_next_period"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_back3"
                    android:rotation="180"
                    android:padding="2dp"
                    app:tint="@color/budget_primary"/>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_add_budget"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_multiple"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/budget_text_main"/>

        <!-- 周月年 Tab 切换 -->
        <LinearLayout
            android:id="@+id/ll_period_tabs_top"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_capsule_gray"
            android:padding="2dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ll_title_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tab_week"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:text="周"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/budget_text_aux"/>

            <TextView
                android:id="@+id/tab_month"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:text="月"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/budget_text_main"
                android:background="@drawable/bg_tab_selected_white"/>

            <TextView
                android:id="@+id/tab_year"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:text="年"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/budget_text_aux"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:background="@color/budget_page_bg"
        app:layout_constraintTop_toBottomOf="@id/cl_top_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipToPadding="false">

            <!-- 核心预算卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_budget_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/budget_card_bg"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tv_date_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="2026.7.22-8.21"
                            android:textColor="@color/budget_text_main"
                            android:textSize="15sp" />

                        <!-- 收支切换 Tab (集成的卡片内) -->
                        <LinearLayout
                            android:id="@+id/ll_trans_type_switch"
                            android:layout_width="120dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_capsule_gray"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/tab_stats_bottom"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_tab_selected_white"
                                android:gravity="center"
                                android:text="支出"
                                android:textColor="@color/budget_text_main"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tab_composition_bottom"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="收入"
                                android:textColor="@color/budget_text_aux"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <View
                            android:layout_width="3dp"
                            android:layout_height="12dp"
                            android:background="@color/budget_primary"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:id="@+id/tv_remaining_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="月预算剩余"
                            android:textSize="13sp"
                            android:textColor="@color/budget_primary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tv_budget_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥1650.00"
                            android:textColor="@color/budget_text_main"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_edit_main_budget"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_pencil"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="6dp"
                            app:tint="@color/budget_text_aux"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="10sp"
                        android:textColor="@color/budget_text_aux"
                        android:layout_marginTop="8dp"/>

                    <ProgressBar
                        android:id="@+id/progress_budget"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:progress="0"
                        android:layout_marginTop="2dp"
                        android:progressDrawable="@drawable/bg_progress_thin"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tv_used"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="已用 ¥0.00"
                            android:textSize="12sp"
                            android:textColor="@color/budget_text_aux"/>
                        <TextView
                            android:id="@+id/tv_total_amount_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥1650.00"
                            android:textSize="12sp"
                            android:textColor="@color/budget_text_aux"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 年度概览卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_yearly_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/budget_card_bg"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="年度概览"
                        android:textStyle="bold"
                        android:textColor="@color/budget_text_main"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- 收入进度 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="收入"
                        android:textSize="14sp"
                        android:textColor="@color/budget_text_secondary"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <ProgressBar
                            android:id="@+id/pb_yearly_income"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="30"
                            android:progressDrawable="@drawable/bg_progress_income"/>
                        <TextView
                            android:id="@+id/tv_yearly_income_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_below="@id/pb_yearly_income"
                            android:text="12715 / 200000.04"
                            android:textSize="11sp"
                            android:textColor="@color/budget_text_aux"
                            android:layout_marginTop="2dp"/>
                    </RelativeLayout>

                    <!-- 支出进度 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="支出"
                        android:textSize="14sp"
                        android:textColor="@color/budget_text_secondary"
                        android:layout_marginTop="12dp"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <ProgressBar
                            android:id="@+id/pb_yearly_expense"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="10"
                            android:progressDrawable="@drawable/bg_progress_expense"/>
                        <TextView
                            android:id="@+id/tv_yearly_expense_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_below="@id/pb_yearly_expense"
                            android:text="9823 / 99999.96"
                            android:textSize="11sp"
                            android:textColor="@color/budget_text_aux"
                            android:layout_marginTop="2dp"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 月份水平列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_months"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clipToPadding="false" />

            <!-- 收支明细对比 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_income_detail"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/budget_card_bg"
                    android:layout_marginEnd="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToOutline="true">

                        <ProgressBar
                            android:id="@+id/pb_income_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:progress="0"
                            android:max="10000"
                            android:progressDrawable="@drawable/bg_vertical_progress_income"/>

                        <LinearLayout
                            android:id="@+id/ll_income_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="收入"
                                android:textColor="@color/budget_text_main"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="已入账"
                                android:textSize="12sp"
                                android:textColor="@color/budget_text_aux"
                                android:layout_marginTop="8dp"/>
                            <TextView
                                android:id="@+id/tv_income_actual"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/budget_text_main"
                                android:layout_marginTop="4dp"/>
                            <TextView
                                android:id="@+id/tv_income_budget"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="预算 0.00"
                                android:textSize="12sp"
                                android:textColor="@color/budget_text_aux"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_expense_detail"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/budget_card_bg"
                    android:layout_marginStart="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToOutline="true">

                        <ProgressBar
                            android:id="@+id/pb_expense_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:progress="0"
                            android:max="10000"
                            android:progressDrawable="@drawable/bg_vertical_progress_expense"/>

                        <LinearLayout
                            android:id="@+id/ll_expense_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="支出"
                                android:textColor="@color/budget_text_main"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="已支出"
                                android:textSize="12sp"
                                android:textColor="@color/budget_text_aux"
                                android:layout_marginTop="8dp"/>
                            <TextView
                                android:id="@+id/tv_expense_actual"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/budget_text_main"
                                android:layout_marginTop="4dp"/>
                            <TextView
                                android:id="@+id/tv_expense_budget"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="预算 0.00"
                                android:textSize="12sp"
                                android:textColor="@color/budget_text_aux"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 分类预算列表卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/budget_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:id="@+id/tv_classified_budget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已分类预算 ¥1155.00"
                            android:textColor="@color/budget_text_main"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/btn_add_category_budget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="+ 分类预算"
                            android:textColor="@color/budget_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_category_budgets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_category_budget"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Space to allow scrolling significantly past last card -->
            <View
                android:layout_width="match_parent"
                android:layout_height="200dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
