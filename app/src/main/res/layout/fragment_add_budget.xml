<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_bottom_sheet_white">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置总预算"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/budget_text_main"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- 输入区域 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/budget_divider"
            app:strokeWidth="1dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="预算金额"
                    android:textColor="@color/budget_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/budget_text_main"
                        android:layout_marginEnd="6dp"/>

                    <EditText
                        android:id="@+id/et_amount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/budget_text_main"
                        android:textColorHint="@color/budget_text_aux"
                        android:maxLines="1"
                        android:imeOptions="actionDone"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/btn_3000"
                        style="@style/BudgetQuickButtonStyle"
                        android:text="3000" />

                    <TextView
                        android:id="@+id/btn_5000"
                        style="@style/BudgetQuickButtonStyle"
                        android:text="5000"
                        android:layout_marginHorizontal="6dp" />

                    <TextView
                        android:id="@+id/btn_8000"
                        style="@style/BudgetQuickButtonStyle"
                        android:text="8000" />

                    <TextView
                        android:id="@+id/btn_10000"
                        style="@style/BudgetQuickButtonStyle"
                        android:text="10000"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Reference Suggestion Merged Here -->
                <LinearLayout
                    android:id="@+id/ll_suggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_suggestion_rounded"
                    android:padding="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_suggestion_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="参考建议"
                        android:textColor="@color/budget_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_suggestion_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="根据上月支出 ¥0，建议预算 ¥0 ~ ¥0"
                        android:textColor="@color/budget_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 周期与时间 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/budget_divider"
            app:strokeWidth="1dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="预算周期"
                    android:textColor="@color/budget_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <RadioGroup
                    android:id="@+id/rg_period"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_capsule_gray"
                    android:padding="2dp">

                    <RadioButton
                        android:id="@+id/rb_week"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/selector_budget_tab"
                        android:button="@null"
                        android:gravity="center"
                        android:text="周预算"
                        android:textColor="@drawable/selector_budget_tab_text"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_month"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/selector_budget_tab"
                        android:button="@null"
                        android:gravity="center"
                        android:text="月预算"
                        android:checked="true"
                        android:textColor="@drawable/selector_budget_tab_text"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_year"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/selector_budget_tab"
                        android:button="@null"
                        android:gravity="center"
                        android:text="年预算"
                        android:textColor="@drawable/selector_budget_tab_text"
                        android:textSize="12sp" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/budget_divider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="生效时间"
                    android:textColor="@color/budget_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/ll_date_selector"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_capsule_gray"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/budget_text_secondary" />

                    <TextView
                        android:id="@+id/tv_selected_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="2024年3月"
                        android:textColor="@color/budget_text_main"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_back3"
                        android:rotation="180"
                        app:tint="@color/budget_text_aux" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carry Over Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="自动沿用上个周期预算"
                android:textColor="@color/budget_text_secondary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_carry_over"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppSwitchStyle" />
        </LinearLayout>

        <!-- Smart Yearly Allocation Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_smart_allocation"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="将年预算平均分配到12个月"
            android:textColor="@color/budget_primary"
            android:visibility="gone"
            android:textSize="13sp"
            app:backgroundTint="@color/budget_light_theme_bg"
            app:cornerRadius="22dp"
            app:strokeColor="@color/budget_primary"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <!-- Confirm Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="确认设置"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/budget_primary"
            app:cornerRadius="26dp"
            app:elevation="0dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
